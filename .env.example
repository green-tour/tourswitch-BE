# 실제 값을 채운 뒤 .env 로 복사해서 사용한다. .env 는 커밋하지 않는다.

# Sub Service
FRONTEND_CALLBACK_URI=http://localhost:5173/oauth2/callback
FRONTEND_ORIGIN=http://localhost:5173

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=

# Refresh Token Cookie
REFRESH_COOKIE_SECURE=